{
  "name": "@paykernel/testkit",
  "version": "0.1.0-next.0",
  "description": "Test kit for @paykernel/core: mock gateway, conformance suites, fixture safety, Phase 9 lease-aware store contracts/manifests, NON-PRODUCTION in-memory stores, and optional dual-type integration with @paykernel/webhooks and @paykernel/reconciliation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@paykernel/core": "workspace:*",
    "@paykernel/webhooks": "workspace:*",
    "@paykernel/reconciliation": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "payments",
    "testkit",
    "mock gateway",
    "conformance",
    "paykernel"
  ],
  "author": "Abdelrahman Shaheen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paykernel/paykernel.git",
    "directory": "packages/testkit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/paykernel/paykernel/tree/main/packages/testkit#readme",
  "paymentsSdk": {
    "portable": true
  },
  "bugs": {
    "url": "https://github.com/paykernel/paykernel/issues"
  }
}
